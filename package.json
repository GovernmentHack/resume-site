{
  "name": "resume-site",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://governmenthack.github.io/resume-site",
  "scripts": {
    "start": "webpack-dev-server --open --mode development --hot --no-devtool --no-hot",
    "test:unit:dev": "vitest --ui",
    "test:coverage": "vitest --coverage --coverage.reporter=json-summary --silent --run",
    "coverage-badge:generate": "node generate-badge.js",
    "coverage-badge:update": "npm run test:coverage && npm run coverage-badge:generate && (git commit lines.svg -m 'update test coverage badge' && git push) || echo 'No test coverage changes to update'",
    "build": "webpack --mode production",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "predeploy": "npm run coverage-badge:update && npm run build",
    "deploy": "echo grant.apodaca.pro > ./dist/CNAME && gh-pages -d dist"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "axios": "^1.21.1",
    "react": "18.3.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dnd-touch-backend": "16.0.1",
    "react-dom": "18.3.1",
    "react-modal": "3.16.3",
    "uuid": "14.0.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/react-modal": "3.16.3",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "badge-maker": "6.0.0",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-prettier": "5.5.7",
    "gh-pages": "6.3.0",
    "globals": "14.0.0",
    "html-webpack-plugin": "5.6.8",
    "jsdom": "31.0.0",
    "prettier": "3.10.0",
    "style-loader": "4.0.0",
    "styled-components": "6.6.0",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.1",
    "webpack-dev-server": "6.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
